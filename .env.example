# Copy to .env and fill in. .env is gitignored — do NOT commit real keys.


# Invest account
T212_INVEST_API_KEY=
T212_INVEST_API_SECRET=

# Stocks ISA account
T212_ISA_API_KEY=
T212_ISA_API_SECRET=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# === Free news / market data sources ===
# Finnhub free tier — finnhub.io
FINNHUB_API_KEY=

# NewsAPI free tier — newsapi.org 
NEWSAPI_KEY=

# Alpaca News API 
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# === Reddit (PRAW) ===
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=market-radar/0.1 by yourusername


# === LSEG (Refinitiv) value-chain data — paid supply-chain graph ===
# Cost: enterprise. Cleaner supplier/customer relationships than the
# free 10-K parsing path. Defer — free path is solid for our scale.

# === Daemon / scoring config ===
# Composite score (0-10) above which a macOS notification fires
NOTIFICATION_THRESHOLD=7.5

# Hide penny-stock signals from the main feed by default (still ingested,
# viewable in a separate tab). 1=hide, 0=show
HIDE_PENNY_DEFAULT=1

# Database path (absolute path recommended for the launchd daemon)
DB_PATH=

# Contact string sent in the User-Agent of research scripts (SEC/FINRA ask for one)
RESEARCH_CONTACT_UA=market-radar research (you@example.com)

# SEC EDGAR requires a descriptive User-Agent with contact details
SEC_USER_AGENT=market-radar research (Your Name you@example.com)
