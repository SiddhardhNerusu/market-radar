# Copy to .env and fill in. .env is gitignored — do NOT commit real keys.

# === Trading 212 (real money) ===
# T212 uses HTTP Basic Auth — you need BOTH the API Key AND the API Secret
# that T212 shows you when you generate a key. The Key acts as username, the
# Secret as password. They are concatenated as "KEY:SECRET" and Base64-encoded.
#
# T212 issues one key+secret pair per account, so to access both Invest and
# Stocks ISA you need to generate keys from inside each account separately.
#
# Get from: T212 desktop web → Settings → API (Beta) → Generate API key
# Use the LIVE environment for real-money accounts. Demo is for paper.
T212_BASE_URL=https://live.trading212.com/api/v0

# Invest account
T212_INVEST_API_KEY=
T212_INVEST_API_SECRET=

# Stocks ISA account
T212_ISA_API_KEY=
T212_ISA_API_SECRET=

# === Anthropic API for LLM signal classification ===
# Get from: console.anthropic.com → API Keys
# Estimated cost on Haiku: $15–45/month at 1k–3k signals/day.
# Leave blank to use rule-based heuristics only (free, weaker).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# === Free news / market data sources ===
# Finnhub free tier — finnhub.io
FINNHUB_API_KEY=

# NewsAPI free tier — newsapi.org (1k requests/day on free)
NEWSAPI_KEY=

# Alpaca News API — you should already have these from AUTO TRADER
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# === Reddit (PRAW) ===
# Create an app at reddit.com/prefs/apps → script type
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=market-radar/0.1 by yourusername

# ============================================================
# === PAID DATA SOURCES — uncomment + add key to activate ===
# All prices in USD as of 2026-05. Leave commented for the free path.
# ============================================================

# === Benzinga Pro — 5-15 min faster than Bloomberg on stock news ===
# Cost: $99/mo entry, $166/mo full. Get from benzinga.com/pro
# Wires up real-time pre-tagged news feed.
# BENZINGA_API_KEY=

# === Polygon.io — tick-level historical data + L2 order book ===
# Cost: $79/mo (Stocks Starter). Required for the order-book imbalance
# features and minute-bar backtests. Get from polygon.io
# POLYGON_API_KEY=

# === Unusual Whales — options flow + dark-pool prints + insider feed ===
# Cost: $57/mo Basic, $97/mo Plus. Get from unusualwhales.com
# Activates the options-flow scraper + dark-pool feature.
# UNUSUAL_WHALES_API_KEY=

# === Ortex — premium short-interest (better than free FINRA bimonthly) ===
# Cost: $69/mo. Get from ortex.com
# Higher-frequency short-interest + cost-to-borrow.
# ORTEX_API_KEY=

# === Estimize — buy-side crowd estimates ===
# Cost: $50/mo for API; free read-only website tier. estimize.com
# Better-than-consensus pre-earnings estimates. Free tier is scraped.
# ESTIMIZE_API_KEY=

# === Twitter / X — Basic developer tier ===
# Cost: $200/mo Basic ($100/mo Pro for higher quota).
# Get from developer.x.com
# Defer — Reddit + StockTwits already cover most retail-social signal.
# TWITTER_BEARER_TOKEN=

# === LinkUp Data — job-postings alt-data ===
# Cost: enterprise pricing only (typically $thousands/mo).
# Leading indicator on hiring trends for earnings beats. linkupdata.com
# LINKUP_API_KEY=

# === Voyage AI — LLM embeddings for filing similarity search ===
# Cost: ~$0.10 per 1M tokens. For ~150k filings: ~$15 one-off + ~$2/mo.
# Get from voyageai.com
# Unlocks the "this 8-K reads like prior 8-Ks that returned X%" feature.
# VOYAGE_AI_API_KEY=

# === Bloomberg Terminal — institutional reference ===
# Cost: $2,665/mo. Not recommended for individual use — Benzinga Pro
# delivers the retail-relevant news 5-15 min faster at 1/16 the price.
# Mentioned here only for completeness.

# === LSEG (Refinitiv) value-chain data — paid supply-chain graph ===
# Cost: enterprise. Cleaner supplier/customer relationships than the
# free 10-K parsing path. Defer — free path is solid for our scale.

# === Daemon / scoring config ===
# Composite score (0-10) above which a macOS notification fires
NOTIFICATION_THRESHOLD=7.5

# Hide penny-stock signals from the main feed by default (still ingested,
# viewable in a separate tab). 1=hide, 0=show
HIDE_PENNY_DEFAULT=1

# Database path (absolute path recommended for the launchd daemon)
DB_PATH=

# Contact string sent in the User-Agent of research scripts (SEC/FINRA ask for one)
RESEARCH_CONTACT_UA=market-radar research (you@example.com)

# SEC EDGAR requires a descriptive User-Agent with contact details
SEC_USER_AGENT=market-radar research (Your Name you@example.com)
