# Copy to .env and fill in. .env is gitignored — do NOT commit real keys.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# === Free news / market data sources ===
# Finnhub free tier — finnhub.io
FINNHUB_API_KEY=

# NewsAPI free tier — newsapi.org 
NEWSAPI_KEY=

# Alpaca News API 
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# === LSEG (Refinitiv) value-chain data — paid supply-chain graph ===
# Cost: enterprise. Cleaner supplier/customer relationships than the
# free 10-K parsing path. Defer — free path is solid for our scale.

# === Daemon / scoring config ===
# Composite score (0-10) above which a macOS notification fires
NOTIFICATION_THRESHOLD=7.5

# Hide penny-stock signals from the main feed by default (still ingested,
# viewable in a separate tab). 1=hide, 0=show
HIDE_PENNY_DEFAULT=1

# Database path (absolute path recommended for the launchd daemon)
DB_PATH=

# Contact string sent in the User-Agent of research scripts (SEC/FINRA ask for one)
RESEARCH_CONTACT_UA=market-radar research (you@example.com)

# SEC EDGAR requires a descriptive User-Agent with contact details
SEC_USER_AGENT=market-radar research (Your Name you@example.com)

# === Insider lane (scripts/run_insider_lane.py) — PAPER ONLY ===
# The capital you actually have. Alpaca paper shows $100k; every % below is
# relative to THIS number, so the loss you see is the loss you'd really take.
LANE_BOOK_EQUITY_USD=10000
# What counts as a bet: Form 4 code-P open-market buys, summed per (ticker, day)
LANE_MIN_NOTIONAL_USD=25000
LANE_MIN_PRICE=10
LANE_MIN_ROLE_SCORE=0          # 2 = director or above, 3 = C-suite only
LANE_EXCLUDE_10B5_1=1
LANE_FRESHNESS_HOURS=48
# Risk: 0.5% of the book per bet on a 2xATR broker-side stop, 2R target,
# <= 5 names, <= 5% open risk in total, 3% daily loss flattens everything.
LANE_RISK_PER_TRADE_PCT=0.5
LANE_STOP_ATR_MULT=2.0
LANE_TP_ATR_MULT=4.0
LANE_MAX_POSITIONS=5
LANE_MAX_PORTFOLIO_HEAT_PCT=5
LANE_DAILY_LOSS_PCT=3
LANE_MAX_HOLD_CALENDAR_DAYS=14
LANE_DRY_RUN=0
