<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.marketradar.retrain</string>
  <key>ProgramArguments</key><array>
    <string>__HOME__/Documents/Claude/Projects/MARKET RADAR/.venv/bin/python</string>
    <string>__HOME__/Documents/Claude/Projects/MARKET RADAR/scripts/scheduled_retrain.py</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/Documents/Claude/Projects/MARKET RADAR</string>
  <!-- DAILY retrain at 04:00 UTC (pre-market). Continuously absorbs
       fresh outcomes as they resolve overnight. Each run auto-deploys
       if AUC holds; the AUC-gate in scripts/scheduled_retrain.py
       refuses deployment if a retrain degrades model quality. -->
  <key>StartCalendarInterval</key><dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/Documents/Claude/Projects/MARKET RADAR/logs/launchd-retrain.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Documents/Claude/Projects/MARKET RADAR/logs/launchd-retrain.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
